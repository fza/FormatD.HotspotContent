prototype(FormatD.HotspotContent:Content.ImageWithHotspots) < prototype(Neos.Neos:ContentComponent) {

	renderer = FormatD.HotspotContent:Molecule.ContentWithHotspots {
		content = FormatD.HotspotContent:Content.Image
		hotspots = Neos.Neos:ContentCollection {
			nodePath = 'hotspots'
		}
		hotspotNodeTypes = ${Array.filter(Array.unique(Array.map(q(node).children('[instanceof Neos.Neos:ContentCollection]').children('[instanceof FormatD.HotspotEditor:Content.Hotspot]').get(), child => child.nodeTypeName.value)), typeName => typeName != 'FormatD.HotspotEditor:Content.Hotspot')}
	}

}
